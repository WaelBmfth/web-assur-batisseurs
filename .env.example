# Modèle de configuration (aucun secret ici). Copier en .env.local pour le développement,
# ou définir ces variables dans Vercel → Settings → Environment Variables.

# --- Administration ---
# ADMIN_PASSWORD=
# ADMIN_USER=admin

# --- Stockage (fourni automatiquement par Vercel quand un Blob store est relié au projet) ---
# BLOB_READ_WRITE_TOKEN=
# PRICING_BLOB_ACCESS=private

# --- Questionnaires : PDF envoyé par e-mail (Resend) ---
# RESEND_API_KEY=
# QUESTIONNAIRE_EMAIL_FROM="AssurBâtisseurs <questionnaires@assurbatisseurs.fr>"
# QUESTIONNAIRE_EMAIL_BCC=
# QUESTIONNAIRE_EMAIL_REPLY_TO=contact@assurbatisseurs.fr
# Preview / recette : tous les e-mails partent vers cette adresse de test, jamais vers le client.
# QUESTIONNAIRE_EMAIL_REDIRECT_TO=

# Développement : aucun envoi réel, e-mails et PDF écrits dans storage/outbox/
QUESTIONNAIRE_EMAIL_TRANSPORT=outbox
